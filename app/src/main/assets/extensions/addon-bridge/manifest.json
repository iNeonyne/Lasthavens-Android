{
  "manifest_version": 2,
  "name": "LastHaven Addon Bridge",
  "version": "0.5.1",
  "description": "Launcher-owned, read-only bridge between the LastHaven game session and the local launcher addon library.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lasthaven-addon-bridge@neonyne",
      "strict_min_version": "160.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lasthavens.com/play",
        "https://lasthavens.com/play/",
        "https://alt.lasthavens.com/play",
        "https://alt.lasthavens.com/play/"
      ],
      "js": [
        "payload-validation.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    },
    {
      "matches": [
        "https://lasthavens.com/play",
        "https://lasthavens.com/play/",
        "https://alt.lasthavens.com/play",
        "https://alt.lasthavens.com/play/"
      ],
      "js": [
        "xhr-overlay.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lasthavens.com/play",
        "https://lasthavens.com/play/",
        "https://alt.lasthavens.com/play",
        "https://alt.lasthavens.com/play/"
      ],
      "js": [
        "worker-overlay.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lasthavens.com/play",
        "https://lasthavens.com/play/",
        "https://alt.lasthavens.com/play",
        "https://alt.lasthavens.com/play/"
      ],
      "js": [
        "addon-bootstrap.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false,
      "world": "MAIN"
    }
  ]
}
